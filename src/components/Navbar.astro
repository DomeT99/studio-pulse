---
export interface Props {
    currentPage?: string;
}

const { currentPage } = Astro.props;

function isCurrent(page: string) {
    return currentPage === page ? { "aria-current": "page" as const } : {};
}
---

<nav class="navbar is-dark" aria-label="main navigation">
    <div class="navbar-brand">
        <a class="navbar-item" href="/"> Studio Pulse </a>
        <button
            type="button"
            class="navbar-burger"
            aria-label="menu"
            aria-expanded="false"
            data-target="mainNavbar"
        >
            <span aria-hidden="true"></span>
            <span aria-hidden="true"></span>
            <span aria-hidden="true"></span>
        </button>
    </div>
    <div id="mainNavbar" class="navbar-menu">
        <div class="navbar-end">
            <a class="navbar-item" href="/" {...isCurrent("home")}>Home</a>
            <a class="navbar-item" href="/about" {...isCurrent("about")}>About</a>
            <a class="navbar-item" href="/blog" {...isCurrent("blog")}>Blog</a>
            <a class="navbar-item" href="/contact" {...isCurrent("contact")}>Contact</a>
            <div class="navbar-item">
                <button
                    class="theme-toggle"
                    type="button"
                    aria-label="Toggle dark mode"
                >
                    <span class="icon-sun" aria-hidden="true">☀️</span>
                    <span class="icon-moon" aria-hidden="true">🌙</span>
                </button>
            </div>
        </div>
    </div>
</nav>

<script>
    (() => {
        function applyTheme(isDark: boolean) {
            if (isDark) {
                document.documentElement.setAttribute("data-theme", "dark");
                localStorage.setItem("theme", "dark");
            } else {
                document.documentElement.removeAttribute("data-theme");
                localStorage.setItem("theme", "light");
            }
        }

        function syncTheme() {
            const stored = localStorage.getItem("theme");
            const prefersDark = window.matchMedia(
                "(prefers-color-scheme: dark)",
            ).matches;
            if (stored === "dark" || (!stored && prefersDark)) {
                document.documentElement.setAttribute("data-theme", "dark");
            } else if (stored === "light") {
                document.documentElement.removeAttribute("data-theme");
            }
        }

        document.addEventListener("click", (e) => {
            const burger = (e.target as Element).closest(".navbar-burger");
            if (burger) {
                const target = burger.getAttribute("data-target");
                const menu = document.getElementById(target!);
                if (menu) {
                    burger.classList.toggle("is-active");
                    menu.classList.toggle("is-active");
                }
                return;
            }

            const toggle = (e.target as Element).closest(".theme-toggle");
            if (toggle) {
                const isDark = document.documentElement.hasAttribute("data-theme");
                const next = !isDark;
                if (!document.startViewTransition) {
                    applyTheme(next);
                    return;
                }
                document.startViewTransition(() => applyTheme(next));
            }
        });

        syncTheme();
        document.addEventListener("astro:page-load", syncTheme);
    })();
</script>