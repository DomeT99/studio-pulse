---
import { ClientRouter } from "astro:transitions";
import "bulma/css/bulma.min.css";
import "../styles/global.css";

export interface Props {
    title: string;
    description?: string;
    currentPage?: string;
}

const { title, description, currentPage } = Astro.props;

const metaDescription =
    description ??
    "Studio Pulse — Full-service communication agency. Brand strategy, creative direction, digital, and content.";

function isCurrent(page: string) {
    return currentPage === page ? { "aria-current": "page" as const } : {};
}
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="viewport" content="width=device-width" />
        <meta name="description" content={metaDescription} />
        <meta name="generator" content={Astro.generator} />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            rel="preload"
            as="style"
            href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400;14..32,500;14..32,600;14..32,700;14..32,800&display=swap"
        />
        <link
            rel="stylesheet"
            href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400;14..32,500;14..32,600;14..32,700;14..32,800&display=swap"
            media="print"
            onload="this.media='all'"
        />
        <title>{title} — Studio Pulse</title>
        <script is:inline>
            const stored = localStorage.getItem("theme");
            const prefersDark = window.matchMedia(
                "(prefers-color-scheme: dark)",
            ).matches;
            if (stored === "dark" || (!stored && prefersDark)) {
                document.documentElement.setAttribute("data-theme", "dark");
            }
        </script>
        <ClientRouter />
    </head>
    <body>
        <a class="skip-link" href="#main-content">Skip to main content</a>

        <nav class="navbar is-dark" aria-label="main navigation">
            <div class="navbar-brand">
                <a class="navbar-item" href="/"> Studio Pulse </a>
                <button
                    type="button"
                    class="navbar-burger"
                    aria-label="menu"
                    aria-expanded="false"
                    data-target="mainNavbar"
                >
                    <span aria-hidden="true"></span>
                    <span aria-hidden="true"></span>
                    <span aria-hidden="true"></span>
                </button>
            </div>
            <div id="mainNavbar" class="navbar-menu">
                <div class="navbar-end">
                    <a class="navbar-item" href="/" {...isCurrent("home")}
                        >Home</a
                    >
                    <a class="navbar-item" href="/about" {...isCurrent("about")}
                        >About</a
                    >
                    <a class="navbar-item" href="/blog" {...isCurrent("blog")}
                        >Blog</a
                    >
                    <a
                        class="navbar-item"
                        href="/contact"
                        {...isCurrent("contact")}>Contact</a
                    >
                    <div class="navbar-item">
                        <button
                            class="theme-toggle"
                            type="button"
                            aria-label="Toggle dark mode"
                        >
                            <span class="icon-sun" aria-hidden="true">☀️</span>
                            <span class="icon-moon" aria-hidden="true">🌙</span>
                        </button>
                    </div>
                </div>
            </div>
        </nav>

        <main id="main-content">
            <slot />
        </main>

        <footer class="footer">
            <div class="content has-text-centered">
                <p class="mb-2">
                    <strong class="has-text-white">Studio Pulse</strong>
                </p>
                <p>
                    &copy; {new Date().getFullYear()} Studio Pulse. All rights reserved.
                </p>
            </div>
        </footer>

        <script>
            function initNav() {
                const stored = localStorage.getItem("theme");
                const prefersDark = window.matchMedia(
                    "(prefers-color-scheme: dark)",
                ).matches;
                if (stored === "dark" || (!stored && prefersDark)) {
                    document.documentElement.setAttribute("data-theme", "dark");
                } else {
                    document.documentElement.removeAttribute("data-theme");
                }

                document.querySelectorAll(".navbar-burger").forEach((el) => {
                    el.addEventListener("click", () => {
                        const target = el.getAttribute("data-target");
                        const menu = target
                            ? document.getElementById(target)
                            : null;
                        if (!menu) return;
                        const expanded = el.classList.toggle("is-active");
                        el.setAttribute("aria-expanded", String(expanded));
                        menu.classList.toggle("is-active");
                    });
                });

                function applyTheme(isDark: boolean) {
                    if (isDark) {
                        document.documentElement.setAttribute(
                            "data-theme",
                            "dark",
                        );
                        localStorage.setItem("theme", "dark");
                    } else {
                        document.documentElement.removeAttribute("data-theme");
                        localStorage.setItem("theme", "light");
                    }
                }

                const toggleBtn = document.querySelector(".theme-toggle");
                if (toggleBtn) {
                    toggleBtn.addEventListener("click", () => {
                        const isDark =
                            document.documentElement.hasAttribute("data-theme");
                        const next = !isDark;
                        if (!document.startViewTransition) {
                            applyTheme(next);
                            return;
                        }
                        document.startViewTransition(() => applyTheme(next));
                    });
                }
            }

            initNav();
            document.addEventListener("astro:page-load", initNav);
        </script>
    </body>
</html>
