---
import "bulma/css/bulma.min.css";
import "../styles/global.css";

export interface Props {
    title: string;
    description?: string;
    currentPage?: string;
}

const { title, description, currentPage } = Astro.props;

const metaDescription =
    description ??
    "Studio Pulse — Full-service communication agency. Brand strategy, creative direction, digital, and content.";

function isCurrent(page: string) {
    return currentPage === page ? { "aria-current": "page" as const } : {};
}
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="viewport" content="width=device-width" />
        <meta name="description" content={metaDescription} />
        <meta name="generator" content={Astro.generator} />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            rel="preload"
            as="style"
            href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400;14..32,500;14..32,600;14..32,700;14..32,800&display=swap"
        />
        <link
            rel="stylesheet"
            href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400;14..32,500;14..32,600;14..32,700;14..32,800&display=swap"
            media="print"
            onload="this.media='all'"
        />
        <title>{title} — Studio Pulse</title>
    </head>
    <body>
        <a class="skip-link" href="#main-content">Skip to main content</a>

        <nav
            class="navbar is-dark"
            aria-label="main navigation"
        >
            <div class="navbar-brand">
                <a class="navbar-item" href="/">
                    Studio Pulse
                </a>
                <button
                    type="button"
                    class="navbar-burger"
                    aria-label="menu"
                    aria-expanded="false"
                    data-target="mainNavbar"
                >
                    <span aria-hidden="true"></span>
                    <span aria-hidden="true"></span>
                    <span aria-hidden="true"></span>
                </button>
            </div>
            <div id="mainNavbar" class="navbar-menu">
                <div class="navbar-end">
                    <a class="navbar-item" href="/" {...isCurrent("home")}>Home</a>
                    <a class="navbar-item" href="/about" {...isCurrent("about")}>About</a>
                    <a class="navbar-item" href="/contact" {...isCurrent("contact")}>Contact</a>
                </div>
            </div>
        </nav>

        <main id="main-content">
            <slot />
        </main>

        <footer class="footer">
            <div class="content has-text-centered">
                <p class="mb-2">
                    <strong class="has-text-white">Studio Pulse</strong>
                </p>
                <p>
                    &copy; {new Date().getFullYear()} Studio Pulse. All rights reserved.
                </p>
            </div>
        </footer>

        <script>
            document.querySelectorAll(".navbar-burger").forEach((el) => {
                el.addEventListener("click", () => {
                    const target = el.getAttribute("data-target");
                    const menu = target ? document.getElementById(target) : null;
                    if (!menu) return;
                    const expanded = el.classList.toggle("is-active");
                    el.setAttribute("aria-expanded", String(expanded));
                    menu.classList.toggle("is-active");
                });
            });
        </script>
    </body>
</html>