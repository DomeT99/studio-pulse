---
import Layout from "../layouts/Layout.astro";
---

<Layout title="About Us">
	<div class="has-text-centered mb-6">
		<h1 class="title is-1">About Us</h1>
		<p class="subtitle is-4">A passionate team dedicated to digital excellence.</p>
	</div>

	<div class="content is-medium" style="max-width: 800px; margin: 0 auto;">
		<p>
			Studio Pulse was founded with a simple mission: to help businesses
			thrive in the digital age. We believe that great design and solid
			engineering go hand in hand.
		</p>
		<p>
			Our team brings together experts in design, development, and strategy,
			working collaboratively to deliver solutions that make a real impact.
			We focus on understanding your goals and crafting experiences that
			your users will love.
		</p>

		<h2>Our Values</h2>
		<ul>
			<li><strong>Quality first</strong> — we never compromise on craftsmanship.</li>
			<li><strong>Collaboration</strong> — great results come from great teamwork.</li>
			<li><strong>Continuous learning</strong> — the digital landscape evolves, and so do we.</li>
		</ul>
	</div>
</Layout>