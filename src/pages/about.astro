---
import Layout from "../layouts/Layout.astro";
---

<Layout title="About Us">
	<section class="section section-hero">
		<div class="container has-text-centered">
			<p class="tag is-primary is-medium mb-5">About</p>
			<h1 class="title is-1 has-text-white">
				We are Studio Pulse
			</h1>
			<p class="subtitle is-4 mt-4" style="max-width: 640px; margin-left: auto; margin-right: auto;">
				A tight-knit team of strategists, designers, writers,
				and developers obsessed with making brands unforgettable.
			</p>
		</div>
	</section>

	<section class="section has-bg-elevated">
		<div class="container">
			<div class="columns is-vcentered">
				<div class="column is-half">
					<p class="has-text-muted is-uppercase is-size-7 has-text-weight-semibold mb-3" style="letter-spacing: 0.1em;">
						Our story
					</p>
					<h2 class="title is-2 has-text-white">
						Born from the belief that great communication changes everything
					</h2>
				</div>
				<div class="column is-half">
					<div class="content is-medium">
						<p>
							Studio Pulse was founded on a simple conviction: every brand
							has a story worth telling, and telling it well is the difference
							between being seen and being remembered.
						</p>
						<p>
							We bring together strategic rigor and creative fire. No filler,
							no templates — just sharp thinking and meticulous craft, tailored
							to the people you're trying to reach.
						</p>
						<p>
							From startups finding their voice to established brands rewriting
							their narrative, we partner with ambitious teams who refuse to blend in.
						</p>
					</div>
				</div>
			</div>
		</div>
	</section>

	<section class="section">
		<div class="container">
			<div class="has-text-centered mb-6">
				<p class="has-text-muted is-uppercase is-size-7 has-text-weight-semibold" style="letter-spacing: 0.1em;">
					How we work
				</p>
				<h2 class="title is-2 has-text-white mt-3">
					Principles we live by
				</h2>
			</div>
			<div class="columns is-multiline">
				<div class="column is-one-third">
					<div class="box">
						<h3 class="title is-4">Craft over volume</h3>
						<p>
							We take on fewer projects so we can go deeper. Every pixel,
							every word, every frame matters.
						</p>
					</div>
				</div>
				<div class="column is-one-third">
					<div class="box">
						<h3 class="title is-4">Strategy drives creative</h3>
						<p>
							Beautiful work without thinking behind it is decoration.
							We anchor every idea in insight.
						</p>
					</div>
				</div>
				<div class="column is-one-third">
					<div class="box">
						<h3 class="title is-4">No egos, just outcomes</h3>
						<p>
							Ideas win on merit. We check titles at the door and
							rally around the best path forward.
						</p>
					</div>
				</div>
				<div class="column is-one-third">
					<div class="box">
						<h3 class="title is-4">Ship, learn, iterate</h3>
						<p>
							Perfectionism kills momentum. We bias toward action,
							measure real results, and refine relentlessly.
						</p>
					</div>
				</div>
				<div class="column is-one-third">
					<div class="box">
						<h3 class="title is-4">Radical transparency</h3>
						<p>
							Clients see everything: timelines, work-in-progress,
							challenges. Trust is built in the open.
						</p>
					</div>
				</div>
				<div class="column is-one-third">
					<div class="box">
						<h3 class="title is-4">Long-term partnership</h3>
						<p>
							We're not a one-and-done agency. We invest in
							relationships that grow with every collaboration.
						</p>
					</div>
				</div>
			</div>
		</div>
	</section>
</Layout>