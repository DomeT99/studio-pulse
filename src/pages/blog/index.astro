---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";

const posts = (await getCollection("blog")).sort(
    (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
---

<Layout title="Blog" currentPage="blog">
    <section class="section section-hero">
        <div class="container has-text-centered">
            <p class="tag is-primary is-medium mb-5">Journal</p>
            <h1 class="title is-1">
                Ideas, insights, and<br /> what we're thinking about
            </h1>
            <p class="subtitle is-4 mt-4 u-constrained">
                Notes from the Studio Pulse team on branding, strategy,
                creative process, and the craft of communication.
            </p>
        </div>
    </section>

    <section class="section has-bg-elevated">
        <div class="container u-prose">
            {
                posts.length === 0 ? (
                    <p class="has-text-centered has-text-muted">
                        No posts yet. Check back soon.
                    </p>
                ) : (
                    <div class="blog-list">
                        {posts.map((post) => (
                            <article class="blog-card">
                                <div class="blog-card-meta">
                                    <span class="blog-card-date">
                                        {post.data.date.toLocaleDateString("en-US", {
                                            year: "numeric",
                                            month: "short",
                                            day: "numeric",
                                        })}
                                    </span>
                                    {post.data.tags && (
                                        <div class="blog-card-tags">
                                            {post.data.tags.map((t) => (
                                                <span class="tag">{t}</span>
                                            ))}
                                        </div>
                                    )}
                                </div>
                                <h2 class="blog-card-title">
                                    <a href={`/blog/${post.id}/`}>
                                        {post.data.title}
                                    </a>
                                </h2>
                                <p class="blog-card-excerpt">{post.data.description}</p>
                                <p class="blog-card-author">By {post.data.author}</p>
                            </article>
                        ))}
                    </div>
                )
            }
        </div>
    </section>
</Layout>