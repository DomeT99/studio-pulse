---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Contact" currentPage="contact">
	<section class="section section-hero" aria-labelledby="contact-heading">
		<div class="container has-text-centered">
			<p class="tag is-primary is-medium mb-5">Contact</p>
			<h1 id="contact-heading" class="title is-1">
				Let's make something great
			</h1>
			<p class="subtitle is-4 mt-4 u-constrained-sm">
				New project, partnership, or just want to say hello?
				We read every message.
			</p>
		</div>
	</section>

	<section class="section has-bg-elevated" aria-label="Contact form">
		<div class="container u-constrained-md">
			<form class="box is-spacious">
				<div class="field">
					<label class="label" for="name">Full name</label>
					<div class="control">
						<input class="input is-medium" id="name" type="text" placeholder="Jane Cooper" required autocomplete="name" />
					</div>
				</div>
				<div class="field">
					<label class="label" for="email">Work email</label>
					<div class="control">
						<input class="input is-medium" id="email" type="email" placeholder="jane@company.com" required autocomplete="email" />
					</div>
				</div>
				<div class="field">
					<label class="label" for="budget">Budget range</label>
					<div class="control">
						<div class="select is-medium is-fullwidth">
							<select id="budget" required>
								<option value="" disabled selected>Select a range</option>
								<option value="10k-25k">$10k – $25k</option>
								<option value="25k-50k">$25k – $50k</option>
								<option value="50k-100k">$50k – $100k</option>
								<option value="100k+">$100k+</option>
							</select>
						</div>
					</div>
				</div>
				<div class="field">
					<label class="label" for="message">Tell us about the project</label>
					<div class="control">
						<textarea class="textarea is-medium" id="message" placeholder="Goals, timeline, what success looks like..." rows="5"></textarea>
					</div>
				</div>
				<div class="field mt-5">
					<div class="control">
						<button class="button is-primary is-medium is-fullwidth" type="submit">
							Send message
						</button>
					</div>
				</div>
			</form>

			<div class="has-text-centered mt-6">
				<p class="is-size-5 has-text-weight-semibold has-text-white mb-4">
					Prefer to reach out directly?
				</p>
				<p class="mb-2">
					<a href="mailto:hello@example.com" class="has-text-primary">hello@example.com</a>
				</p>
			</div>
		</div>
	</section>
</Layout>