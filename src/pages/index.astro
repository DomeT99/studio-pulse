---
import Layout from "../layouts/Layout.astro";
import Card from "../components/Card.astro";
---

<Layout title="Home">
	<section class="section section-hero">
		<div class="container has-text-centered">
			<p class="tag is-primary is-medium mb-5">Creative Studio</p>
			<h1 class="title is-1 has-text-white">
				We make brands<br /> impossible to ignore
			</h1>
			<p class="subtitle is-4 mt-4 u-constrained">
				Studio Pulse is a full-service communication agency that
				blends creative direction, brand strategy, and digital craft
				to build experiences that demand attention.
			</p>
			<div class="buttons is-centered mt-6">
				<a class="button is-primary is-large" href="/contact">Start a project</a>
				<a class="button is-outlined is-large" href="/about">Our work</a>
			</div>
		</div>
	</section>

	<section class="section has-bg-elevated">
		<div class="container">
			<div class="has-text-centered mb-6">
				<p class="u-label-overline">
					What we do
				</p>
				<h2 class="title is-2 has-text-white mt-3">
					Everything your brand needs,<br /> under one roof
				</h2>
			</div>
			<div class="columns is-multiline">
				<Card title="Brand Strategy" icon="🎯">
					Positioning, architecture, and narrative frameworks that
					give your brand clarity and conviction in crowded markets.
				</Card>
				<Card title="Creative Direction" icon="✨">
					Visual identity, art direction, and campaign concepts that
					stop the scroll and stick in memory.
				</Card>
				<Card title="Digital & Motion" icon="⚡">
					Websites, apps, and motion design built for performance,
					crafted to feel as good as they look.
				</Card>
				<Card title="Content & Social" icon="📣">
					Editorial strategy, copywriting, and social campaigns
					that turn audiences into communities.
				</Card>
				<Card title="UX & Product Design" icon="📐">
					Research-driven interfaces, design systems, and prototypes
					that ship fast and scale gracefully.
				</Card>
				<Card title="Video Production" icon="🎬">
					From concept to final cut — commercial, branded content,
					and storytelling that moves people.
				</Card>
			</div>
		</div>
	</section>

	<section class="section">
		<div class="container has-text-centered">
			<p class="tag is-primary is-medium mb-5">Let's talk</p>
			<h2 class="title is-2 has-text-white">
				Ready to make noise?
			</h2>
			<p class="subtitle is-4 mt-3 u-constrained-sm">
				The best brands don't whisper. Let's build something that
				gets heard.
			</p>
			<a class="button is-primary is-large mt-5" href="/contact">
				Get in touch
			</a>
		</div>
	</section>
</Layout>